{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-platform/schemas/test-cases.schema.json",
  "title": "Designed test cases (test-designer output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["workItemId", "testCases", "coverageNotes"],
  "properties": {
    "workItemId": { "type": "integer" },
    "coverageNotes": { "type": "string", "description": "Which acceptance criteria / dimensions are covered and what is deliberately not" },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "priority", "type", "technique", "surface", "automationCandidate", "acceptanceCriterionRef", "preconditions", "steps"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 250 },
          "priority": { "enum": [1, 2, 3, 4] },
          "type": { "enum": ["functional", "negative", "boundary", "security", "performance", "accessibility", "usability", "compatibility", "resilience", "data"] },
          "technique": { "enum": ["equivalence-partitioning", "boundary-value", "decision-table", "state-transition", "pairwise", "error-guessing", "use-case", "exploratory-charter"] },
          "surface": { "enum": ["web", "api", "mobile", "desktop", "cross-surface"] },
          "automationCandidate": { "type": "boolean" },
          "acceptanceCriterionRef": { "type": "string", "minLength": 1, "description": "Which AC (quote or number) this case proves" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "expected"],
              "properties": {
                "action": { "type": "string", "minLength": 1 },
                "expected": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
