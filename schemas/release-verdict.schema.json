{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-platform/schemas/release-verdict.schema.json",
  "title": "Release recommendation (release-judge output, advisory)",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "recommendation", "confidence", "summary", "blockingIssues", "risks", "evidenceReviewed", "dimensionCoverage"],
  "properties": {
    "releaseId": { "type": "string" },
    "recommendation": { "enum": ["go", "go-with-risks", "no-go"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string", "maxLength": 2000 },
    "blockingIssues": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "severity", "mitigation"],
        "properties": {
          "description": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "evidenceReviewed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "status"],
        "properties": {
          "source": { "type": "string" },
          "status": { "enum": ["pass", "fail", "missing", "stale"] },
          "note": { "type": "string" }
        }
      }
    },
    "dimensionCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "status"],
        "properties": {
          "dimension": { "type": "string" },
          "status": { "enum": ["covered", "partial", "not-covered", "not-applicable"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
