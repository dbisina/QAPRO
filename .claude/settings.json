{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsx src/bin/gate.ts:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__azure-devops",
      "mcp__playwright"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(az keyvault secret:*)",
      "Bash(git push --force:*)"
    ]
  },
  "enabledMcpjsonServers": ["azure-devops", "playwright"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
