{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-platform/schemas/sarif-triage.schema.json",
  "title": "Security finding triage (security-analyst output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "summary"],
  "properties": {
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "ruleId", "location", "verdict", "severity", "rationale", "fix"],
        "properties": {
          "tool": { "type": "string" },
          "ruleId": { "type": "string" },
          "location": { "type": "string", "description": "path:line" },
          "verdict": { "enum": ["true-positive", "likely-false-positive", "needs-human"] },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "rationale": { "type": "string" },
          "fix": { "type": "string", "description": "Concrete remediation; suppressions are never applied automatically" }
        }
      }
    }
  }
}
